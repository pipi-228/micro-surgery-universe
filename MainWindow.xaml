<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="⚛ МИКРО-ХИРУРГИЯ ВСЕЛЕННОЙ" 
        Height="700" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#0D0D0D"
        AllowsTransparency="False"
        ResizeMode="CanResize">

    <Window.Resources>
        <!-- Современные градиенты -->
        <LinearGradientBrush x:Key="HeaderGrad" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1A1A2E" Offset="0"/>
            <GradientStop Color="#16213E" Offset="0.5"/>
            <GradientStop Color="#1A1A2E" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="PanelGrad" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#1A1A2E" Offset="0"/>
            <GradientStop Color="#0F0F1A" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ButtonGrad" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF6B6B" Offset="0"/>
            <GradientStop Color="#EE5A5A" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SliderGrad" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#4ECDC4" Offset="0"/>
            <GradientStop Color="#FFD93D" Offset="0.5"/>
            <GradientStop Color="#FF6B6B" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ButtonHoverGrad" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF8A8A" Offset="0"/>
            <GradientStop Color="#FF6B6B" Offset="1"/>
        </LinearGradientBrush>

        <!-- Тени для панелей -->
        <DropShadowEffect x:Key="Shadow" BlurRadius="15" ShadowDepth="0" Opacity="0.3" Color="Black"/>
        <DropShadowEffect x:Key="Glow" BlurRadius="20" ShadowDepth="0" Opacity="0.5" Color="#FF6B6B"/>

        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect" Value="{StaticResource Shadow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="8" 
                                Effect="{TemplateBinding Effect}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource ButtonHoverGrad}"/>
                    <Setter Property="Effect" Value="{StaticResource Glow}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelGrad}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Effect" Value="{StaticResource Shadow}"/>
            <Setter Property="Padding" Value="15,10"/>
        </Style>

        <Style TargetType="Slider">
            <Setter Property="Width" Value="200"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="{StaticResource SliderGrad}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель -->
        <Border Grid.Row="0" Background="{StaticResource HeaderGrad}" Padding="20,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="⚛" FontSize="32" Foreground="#FF6B6B" Margin="0,0,10,0"/>
                    <StackPanel>
                        <TextBlock Text="МИКРО-ХИРУРГИЯ ВСЕЛЕННОЙ" 
                                   FontSize="18" 
                                   Foreground="White" 
                                   FontWeight="Bold"/>
                        <TextBlock Text="Quantum Field Surgeon" 
                                   FontSize="11" 
                                   Foreground="#888" 
                                   FontStyle="Italic"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,20,0">
                    <!-- ОЧКИ -->
                    <Border Style="{StaticResource StatCard}" Margin="5,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⭐ " Foreground="#FFD93D" FontSize="16"/>
                            <TextBlock x:Name="ScoreText" Text="0" Foreground="#FFD93D" FontSize="20" FontWeight="Bold"/>
                            <TextBlock Text=" ОЧКОВ" Foreground="#888" FontSize="12" VerticalAlignment="Bottom" Margin="5,0,0,3"/>
                        </StackPanel>
                    </Border>

                    <!-- ЖИЗНИ -->
                    <Border Style="{StaticResource StatCard}" Margin="5,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💀 " Foreground="#FF6B6B" FontSize="16"/>
                            <TextBlock x:Name="LivesText" Text="3" Foreground="#FF6B6B" FontSize="20" FontWeight="Bold"/>
                            <TextBlock Text=" ЖИЗНИ" Foreground="#888" FontSize="12" VerticalAlignment="Bottom" Margin="5,0,0,3"/>
                        </StackPanel>
                    </Border>

                    <!-- ЧАСТИЦЫ -->
                    <Border Style="{StaticResource StatCard}" Margin="5,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🌀 " Foreground="#FF6B6B" FontSize="16"/>
                            <TextBlock x:Name="ParticlesText" Text="0" Foreground="#4ECDC4" FontSize="20" FontWeight="Bold"/>
                            <TextBlock Text=" ЧАСТИЦ" Foreground="#888" FontSize="12" VerticalAlignment="Bottom" Margin="5,0,0,3"/>
                        </StackPanel>
                    </Border>

                    <!-- РЕГУЛИРОВКА СКОРОСТИ -->
                    <Border Style="{StaticResource StatCard}" Margin="5,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🐢" Foreground="#4ECDC4" FontSize="16" Margin="0,0,5,0"/>
                            <Slider x:Name="SpeedSlider" 
                                    Minimum="0" 
                                    Maximum="100" 
                                    Value="50"
                                    Width="150"
                                    TickFrequency="10"
                                    IsSnapToTickEnabled="False"
                                    ValueChanged="SpeedSlider_ValueChanged"/>
                            <TextBlock x:Name="SpeedValueText" Text="50" Foreground="#FF6B6B" FontSize="14" FontWeight="Bold" Margin="5,0,0,0"/>
                            <TextBlock Text="🔥" Foreground="#FF6B6B" FontSize="16" Margin="5,0,0,0"/>
                        </StackPanel>
                    </Border>

                    <Button x:Name="ResetButton" Content="🔄 НОВАЯ ИГРА" 
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource ButtonGrad}"
                            Margin="15,0,0,0"
                            Click="ResetButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Игровое поле -->
        <Canvas x:Name="GameCanvas" 
                Grid.Row="1" 
                Background="#050508"
                ClipToBounds="True"
                MouseLeftButtonDown="Canvas_MouseLeftButtonDown"
                MouseRightButtonDown="Canvas_MouseRightButtonDown"
                MouseMove="Canvas_MouseMove"
                Cursor="Cross"/>

        <!-- Нижняя панель с подсказками -->
        <Border Grid.Row="2" Background="{StaticResource HeaderGrad}" Padding="15,10">
            <WrapPanel HorizontalAlignment="Center">
                <Border Background="#2D2D3A" CornerRadius="15" Padding="10,5" Margin="5">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🖱️ ЛКМ" Foreground="#FF6B6B" FontWeight="Bold"/>
                        <TextBlock Text=" — удалить частицу " Foreground="#AAA" Margin="5,0"/>
                        <TextBlock Text="(+10 очков)" Foreground="#4ECDC4"/>
                    </StackPanel>
                </Border>

                <Border Background="#2D2D3A" CornerRadius="15" Padding="10,5" Margin="5">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🖱️ ПКМ" Foreground="#FF6B6B" FontWeight="Bold"/>
                        <TextBlock Text=" — создать гравитационную яму " Foreground="#AAA" Margin="5,0"/>
                        <TextBlock Text="(притягивает/отталкивает)" Foreground="#4ECDC4"/>
                    </StackPanel>
                </Border>

                <!-- БОНУСЫ (добавить после ParticlesText) -->
                <Border Style="{StaticResource StatCard}" Margin="5,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🎁 " Foreground="#FFD93D" FontSize="16"/>
                        <TextBlock x:Name="BonusText" Text="АКТИВЕН: НЕТ" Foreground="#4ECDC4" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- ТАЙМЕР БОНУСА -->
                <Border Style="{StaticResource StatCard}" Margin="5,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⏱️ " Foreground="#FF6B6B" FontSize="16"/>
                        <TextBlock x:Name="BonusTimerText" Text="0.0" Foreground="#FFD93D" FontSize="16" FontWeight="Bold"/>
                        <TextBlock Text=" сек" Foreground="#888" FontSize="12" VerticalAlignment="Bottom" Margin="2,0,0,3"/>
                    </StackPanel>
                </Border>

                <Border Background="#2D2D3A" CornerRadius="15" Padding="10,5" Margin="5">
                    <WrapPanel>
                        <TextBlock Text="⚠️ " Foreground="#FFD93D"/>
                        <TextBlock Text="частицы аннигилируют если встретят свою античастицу" Foreground="#AAA"/>
                    </WrapPanel>
                </Border>

                <Border Background="#2D2D3A" CornerRadius="15" Padding="10,5" Margin="5">
                    <WrapPanel>
                        <TextBlock Text="🎚️" Foreground="#4ECDC4"/>
                        <TextBlock Text=" ползунок — регулировка скорости игры" Foreground="#AAA"/>
                    </WrapPanel>
                </Border>
            </WrapPanel>
        </Border>
    </Grid>
</Window>